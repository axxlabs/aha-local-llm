# aha-agent: the agent loop, tools, policy and tunnel client (SPEC §3.1).
FROM docker.io/library/python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --frozen --no-dev --no-install-project
COPY aha_local ./aha_local
RUN uv sync --frozen --no-dev
ENV PATH=/opt/venv/bin:$PATH AHA_DATA_DIR=/data AHA_DOCUMENTS_DIR=/documents AHA_CONFIG_FILE=/config/config.toml
ENTRYPOINT ["aha", "run"]
