# aha-agent: the agent loop, tools, policy and tunnel client (SPEC §3.1).
# Images pinned by multi-arch digest (SPEC §9.2): python:3.12-slim, uv:latest. Update deliberately.
FROM docker.io/library/python@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
COPY --from=ghcr.io/astral-sh/uv@sha256:d3b601f0c7b118bc1753febf7c41cc80981df678445e0254284eecf84db79a7d /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --frozen --no-dev --no-install-project
COPY aha_local ./aha_local
RUN uv sync --frozen --no-dev
ENV PATH=/opt/venv/bin:$PATH AHA_DATA_DIR=/data AHA_CONFIG_FILE=/config/config.toml
ARG AHA_BUILD=unknown
ENV AHA_BUILD=$AHA_BUILD
ENTRYPOINT ["aha", "run"]
