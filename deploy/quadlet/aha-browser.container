# The browser (Playwright MCP, headless Chromium). Fresh profile every session, no saved logins; the
# other aha services are blocked at the browser level, and the agent blocks private addresses in code.
[Unit]
Description=aha browser (Playwright MCP)

[Container]
ContainerName=aha-browser
Image=mcr.microsoft.com/playwright/mcp:latest
Network=aha-egress.network
SecurityLabelDisable=true
NoNewPrivileges=true
ShmSize=1g
PodmanArgs=--memory=4g --pids-limit=1024
Exec=--host 0.0.0.0 --port 8931 --allowed-hosts aha-browser:8931 --caps vision --image-responses allow --isolated --viewport-size 1280,800 --blocked-origins "http://aha-search:8080;http://aha-llm:8081;http://aha-browser:8931"

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
