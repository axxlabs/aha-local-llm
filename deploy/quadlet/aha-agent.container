# The agent: the only container on both networks. Holds the data volume; no other host folders.
[Unit]
Description=aha agent
Wants=aha-llm.service aha-search.service aha-browser.service
After=aha-llm.service aha-search.service aha-browser.service

[Container]
ContainerName=aha-agent
Image=@AGENT_IMAGE@
Network=aha-internal.network
Network=aha-egress.network
SecurityLabelDisable=true
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true
Tmpfs=/tmp
Volume=@DATA@:/data
Volume=@CONFIG@:/config/config.toml:ro
# The data key (SPEC §3.8.1): systemd unseals it into this unit's private in-memory credentials folder (%d).
Volume=%d/data-key:/run/aha/data-key:ro
@GATEWAY_VOLUME@
PodmanArgs=--memory=2g --pids-limit=256

[Service]
LoadCredentialEncrypted=data-key:@DATA_KEY_CRED@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
